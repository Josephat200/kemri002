# Example environment variables for deployment (do NOT commit secrets)
# Copy this file to `.env` locally or set the variables in Render's dashboard.

# App
NODE_ENV=production
PORT=8000

# MySQL (used by backend/src/config/database.ts)
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=kemri_rh_survey

# Frontend
VITE_API_BASE_URL=https://your-backend.example.com
# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=kemri_rh_survey

# Server Configuration
PORT=3000
NODE_ENV=development

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
